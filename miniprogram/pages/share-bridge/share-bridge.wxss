.share-bridge-page {
  position: relative;
  width: 100vw;
  height: 100vh;
  background: #ffffff;
  overflow: hidden;
}

.share-bridge-image {
  width: 100vw;
  height: 100vh;
  display: block;
}

.share-bridge-overlay {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  padding: 44rpx 36rpx 0;
  box-sizing: border-box;
}

.share-bridge-title {
  display: inline-block;
  max-width: 86vw;
  padding: 18rpx 22rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.88);
  color: #111827;
  font-size: 34rpx;
  line-height: 1.45;
  font-weight: 700;
  box-shadow: 0 10rpx 28rpx rgba(0, 0, 0, 0.08);
}
